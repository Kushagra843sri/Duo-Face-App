# Public, client-facing configuration only. Anything prefixed EXPO_PUBLIC_ is
# bundled into the app and visible to end users — never put server secrets here.
# Copy to .env.local (gitignored) and fill in; never commit real values.

# DEVELOPMENT-ONLY UI PREVIEW: set to "merchant" or "driver" to browse that
# side of the app with built-in sample data - no Firebase, no backend, no
# sign-in. Only honored in development builds (ignored in production), shows a
# PREVIEW banner, and saves nothing. Leave unset for the real app.
# EXPO_PUBLIC_UI_PREVIEW=merchant

# Duo-Face API base URL. Required for production builds.
# Development on a PHYSICAL PHONE: leave this unset (the app then uses the
# Expo dev-server machine's address on EXPO_PUBLIC_API_PORT, default 4000), or
# set it explicitly to your computer's LAN address, e.g. http://192.168.1.20:4000
# in app/.env.local (gitignored). Never commit a personal IP.
# localhost only works for the web build / simulators on the same machine.
# EXPO_PUBLIC_API_URL=http://192.168.x.x:4000
# EXPO_PUBLIC_API_PORT=4000

# Firebase *web app* config for the SAME Firebase project the backend verifies
# tokens for (server FIREBASE_PROJECT_ID). Client-safe identifiers, not secrets.
# Firebase console -> Project settings -> Your apps -> Web app -> SDK config.
# Leave unset and the app reports "sign-in is not configured" (nothing is faked).
# NEVER put a service account, private key or Admin credential here.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Maps (build-time, NOT EXPO_PUBLIC_): Google Maps SDK key for the Android
# native build, read by app.config.js and written into the manifest. Restrict
# the key in Google Cloud to this app's package name + signing SHA-1 and the
# Maps SDK for Android. iOS uses Apple Maps and needs no key. Never commit it.
GOOGLE_MAPS_ANDROID_API_KEY=
