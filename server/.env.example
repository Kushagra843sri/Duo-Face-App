# Server-only configuration. Never expose these to the mobile app.

NODE_ENV=development
PORT=4000

# Comma-separated list of allowed CORS origins. Leave empty to keep CORS
# closed until a real web/admin origin is confirmed.
CORS_ORIGIN=

# Firebase Admin SDK — server-only, secret. Verifies the Customer App's
# Firebase ID tokens (see docs/integration/CUSTOMER_APP_REQUIREMENTS.md).
# No Firebase project exists yet; the server boots fine without these set —
# they're only required once authentication is actually invoked.
FIREBASE_PROJECT_ID=

# Option A: explicit service account fields (works on hosts without file
# uploads, e.g. most PaaS providers). Set both, or neither.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Option B: path to a downloaded service-account JSON key for local dev.
# NEVER commit the key file itself. Used only if Option A's fields are unset.
GOOGLE_APPLICATION_CREDENTIALS=

# Live driver tracking (Redis GEO) — server-only (docs/decisions/022).
# Leave empty to disable: the server still runs and tracking endpoints answer
# 503. GPS pings are NEVER written to Firestore as a fallback.
# e.g. redis://localhost:6379 or rediss://user:pass@host:6380 (TLS in production).
REDIS_URL=

# Customer push notifications (FCM via the Firebase Admin credentials above).
# Off unless set to "true"; when off nothing is sent (docs/decisions/024).
PUSH_NOTIFICATIONS_ENABLED=

# Delivery address geocoding — server-side only (docs/decisions/021).
# OpenCage (https://opencagedata.com). Customer delivery addresses are sent
# to OpenCage ONLY for the authorized driver of an assignment, with
# no_record=1. Leave the key empty to disable geocoding: delivery orders still
# work and simply have no map destination. Never expose this to the mobile app.
OPENCAGE_API_KEY=
# Optional. ISO 3166-1 alpha-2 country restriction (e.g. "in").
GEOCODER_COUNTRY_CODE=
# Optional. Minimum OpenCage confidence (1-10) to accept a result; default 7 (~5 km).
GEOCODER_MIN_CONFIDENCE=
# Optional. Provider request timeout in ms; default 5000.
GEOCODER_TIMEOUT_MS=

# Masked driver -> customer calls + delivery-code SMS via Exotel (docs/decisions/028).
# Leave empty to disable: "Call customer" answers 503 and no code SMS is sent.
# Exotel dashboard -> API settings. Never expose any of this to the mobile app.
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
# api.in.exotel.com (Mumbai, default) or api.exotel.com (Singapore).
EXOTEL_SUBDOMAIN=
# The ExoPhone (virtual number) both parties see instead of each other's number.
EXOTEL_CALLER_ID=
# Public HTTPS origin of this server; Exotel posts call status to <PUBLIC_BASE_URL>/webhooks/exotel/call-status
PUBLIC_BASE_URL=
# 16+ random chars. Signs the per-call callback token (Exotel documents no callback signature).
CALL_WEBHOOK_SECRET=
# 16+ random chars. HMAC key for the delivery code. Unset = the code fallback is disabled.
DELIVERY_OTP_SECRET=
# Delivery-code SMS (India requires a DLT-registered sender, entity and template).
EXOTEL_SMS_SENDER=
EXOTEL_DLT_ENTITY_ID=
EXOTEL_DLT_TEMPLATE_ID=
# Exact DLT-approved text; {code} is replaced by the 6 digits.
EXOTEL_SMS_TEMPLATE=

# Profiles: identity, bank and payout details (docs/decisions/029).
# 32-byte base64 key that encrypts PAN / licence / bank account numbers before they reach Firestore:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Unset = those fields answer 503; plaintext is never stored. Back this key up: losing it makes stored values unreadable.
PROFILE_ENCRYPTION_KEY=
# Platform commission in basis points (1000 = 10.00%). Stored on each profile when it is first created. Unset = none recorded.
PLATFORM_COMMISSION_BPS=
# Private Cloudflare R2 bucket for profile / KYC photos (pre-signed URLs only; the bucket must NOT be public).
# Unset = photo upload answers 503, the rest of the profile works.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
